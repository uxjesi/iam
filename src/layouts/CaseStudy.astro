---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  lede: string;
  facts: { label: string; value: string }[];
}

const { title, description, eyebrow, headline, lede, facts } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="case">
    <header class="case-hero">
      <div class="case-eyebrow">{eyebrow}</div>
      <h1 class="case-headline">{headline}</h1>
      <p class="case-lede">{lede}</p>
      <dl class="case-facts">
        {facts.map(({ label, value }) => (
          <div class="fact">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="case-body">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  .case {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 48px 96px;
  }

  .case-hero {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 56px;
    border-bottom: 0.5px solid var(--ink-faint);
  }

  .case-eyebrow {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--teal);
    font-weight: 400;
  }

  .case-headline {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  .case-lede {
    font-family: var(--serif);
    font-size: clamp(19px, 2.4vw, 26px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
    border-left: 2px solid var(--teal);
    padding-left: 20px;
  }

  .case-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 44px;
    margin-top: 8px;
  }

  .fact dt {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 4px;
  }

  .fact dd {
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* ---- body ---- */
  .case-body {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-top: 64px;
  }

  .case-section {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .case-section > .section-label {
    margin-bottom: 0;
    padding-top: 6px;
  }

  .case-section > .section-label::after {
    display: none;
  }

  .case-prose {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 660px;
  }

  .case-prose h2 {
    font-family: var(--serif);
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .case-prose h3 {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0;
  }

  .case-prose p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .case-prose strong {
    font-weight: 500;
    color: var(--ink);
  }

  .case-prose em {
    font-style: italic;
  }

  .case-prose ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 20px;
  }

  .case-prose li {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .case-prose li::marker {
    color: var(--ink-faint);
  }

  .case-prose a {
    color: var(--teal);
    text-decoration: none;
    border-bottom: 0.5px solid var(--teal);
  }

  @media (max-width: 900px) {
    .case { padding: 100px 24px 72px; }
    .case-section { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
