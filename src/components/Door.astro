---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  photo: ImageMetadata;
  alt: string;
  path: string;
  title: string;
}

const { href, photo, alt, path, title } = Astro.props;
---

<a href={href} class="door">
  {/* Rendered at 56px by .door-photo; 112 gives a crisp 2x source. Height is
      left to CSS `object-fit: cover` so the crop matches the original. */}
  <Image class="door-photo" src={photo} alt={alt} width={112} />
  <div class="door-path">{path}</div>
  <div class="door-title">{title}</div>
  <p class="door-desc"><slot /></p>
  <span class="door-arrow" aria-hidden="true">→</span>
</a>
