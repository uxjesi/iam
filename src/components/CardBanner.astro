---
interface Props {
  from: string;
  to: string;
  color: string;
  height?: number;
  size?: number;
  italic?: boolean;
}

const { from, to, color, height = 160, size = 28, italic = false } = Astro.props;
---

<div
  class:list={['banner', { italic }]}
  style={{
    '--banner-from': from,
    '--banner-to': to,
    '--banner-color': color,
    '--banner-height': `${height}px`,
    '--banner-size': `${size}px`,
  }}
>
  <span><slot /></span>
</div>

<style>
  .banner {
    height: var(--banner-height);
    background: linear-gradient(135deg, var(--banner-from) 0%, var(--banner-to) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner span {
    font-family: var(--serif);
    font-size: var(--banner-size);
    color: var(--banner-color);
    font-weight: 300;
    letter-spacing: 0.05em;
    text-align: center;
    padding: 0 16px;
  }

  .banner.italic span {
    font-style: italic;
  }
</style>
