---
// The three-door split is gone. The site makes one argument, so the nav
// shouldn't offer three versions of the person making it.
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];

// Trailing slashes vary between `astro dev` and the built output, so compare
// against a normalized path.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav>
  <a href="/" class="nav-name">Jessica Loredo</a>
  <ul class="nav-links">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }
</style>
