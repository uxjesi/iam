---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Door from '../components/Door.astro';
import WorkCard from '../components/WorkCard.astro';
import CardBanner from '../components/CardBanner.astro';

import creamcoat from '../assets/img/selfie-creamcoat.jpeg';
import blondie from '../assets/img/selfie-blondie.JPG';
import red from '../assets/img/selfie-red.png';
import nymph from '../assets/img/selfie-nymph.png';
import peru from '../assets/img/selfie-peru.jpeg';
import frida from '../assets/img/Frida-Portrait.JPG';
---

<Layout title="Jessica Loredo">
  <section class="hero">
    <div class="hero-text">
      <div class="hero-eyebrow">iam.jessicaloredo.com</div>
      <h1 class="hero-name">Jessica<br /><em>Loredo</em></h1>
      <p class="hero-thesis">I embrace complexity and thrive on making the internal external.</p>
      <div class="hero-cta">
        <a href="#doors" class="btn-primary">Find your way in</a>
        <a href="#work" class="btn-ghost">See the work</a>
      </div>
    </div>
    <div class="hero-photo-wrap">
      <Image class="hero-photo" src={creamcoat} alt="Jessica Loredo" width={880} loading="eager" />
    </div>
  </section>

  <section class="doors-section" id="doors">
    <div class="section-label">find your way in</div>
    <div class="doors">
      <Door
        href="/clinical"
        photo={blondie}
        alt="Jessica — clinical"
        path="/clinical"
        title="The clinician"
      >
        Trauma-informed care, counseling practice, and the path toward private practice. The room
        where healing lives.
      </Door>
      <Door href="/design" photo={red} alt="Jessica — designer" path="/design" title="The designer">
        15+ years of UX and product thinking. Systems made visible, experiences made human.
      </Door>
      <Door href="/work" photo={nymph} alt="Jessica — maker" path="/work" title="The maker">
        Apps, paintings, illustrations, writing, games. The full range of making — in whatever
        medium the work demands.
      </Door>
    </div>
  </section>

  <section class="work-section" id="work">
    <div class="work-inner">
      <div class="section-label">selected work</div>
      <div class="masonry">
        <WorkCard
          href="https://palette.heartandhues.com"
          external
          tag="Full-stack · Community"
          title="Palette"
          desc="A creative community platform for makers. Built from the inside out — Next.js, Redis, PostgreSQL, real-time collaboration."
        >
          <CardBanner from="#0d1a2a" to="#0f3d4a" color="rgba(79,195,200,0.7)" height={180} size={32}>
            Palette
          </CardBanner>
        </WorkCard>

        <WorkCard
          href="#"
          tag="App · Psychology"
          title="Your Inner Constellation"
          desc="A self-reflection tool mapping psychological traits into visual constellations. No diagnosis — just seeing yourself more clearly."
        >
          <CardBanner from="#1a1628" to="#2d1a3a" color="rgba(160,120,210,0.7)" height={140} italic>
            Your Inner Constellation
          </CardBanner>
        </WorkCard>

        <WorkCard
          href="#"
          tag="Art · Digital · Traditional"
          title="Illustration & painting"
          desc="Digital paintings, oils, watercolor, gouache, collage. The luminous dark made visible."
        >
          <Image
            class="work-card-img art-preview"
            src={frida}
            alt="Illustration work"
            width={800}
            style="object-position: center 20%;"
          />
        </WorkCard>

        <WorkCard
          href="#"
          tag="Writing · Games · Education"
          title="Stories & games"
          desc="Children's books, SEL content, game design. Making complex inner worlds accessible to young minds."
        >
          <CardBanner from="#1a2a1a" to="#0f3a2a" color="rgba(79,180,120,0.7)" height={120} size={22}>
            SEL · Games · Stories
          </CardBanner>
        </WorkCard>
      </div>
    </div>
  </section>

  <section class="about-strip" id="about">
    <Image class="about-photo" src={peru} alt="Jessica in Peru" width={760} />
    <div class="about-text">
      <p class="about-quote">"I am many things and I am also just, Jesi."</p>
      <p class="about-body">
        I'm a product designer, clinical counseling intern, illustrator, painter, app developer, and
        emerging author living in Kansas City. I thrive at the intersection of things that are
        supposed to stay separate — the clinical and the creative, the technical and the expressive,
        the interior and the visible.<br /><br />I'm working toward a private practice as a
        trauma-informed clinician, building tools that externalize interior experience, and making
        art in whatever medium the moment requires.
      </p>
    </div>
  </section>
</Layout>
