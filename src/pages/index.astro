---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CaseCard from '../components/CaseCard.astro';
import HowIWork from '../components/HowIWork.astro';
import Contact from '../components/Contact.astro';
import { cases } from '../data/cases.js';

import portrait from '../assets/img/selfie-creamcoat.jpeg';
import aboutPortrait from '../assets/img/selfie-blondie.JPG';

const building = [
  { name: 'Start Your Future', href: 'https://startyourfuture.org', note: 'Career exploration for teens' },
  { name: 'Your Inner Constellation', href: 'https://www.your-inner-constellation.com', note: 'Traits made visible' },
  { name: 'Palette', href: 'https://palette.heartandhues.com', note: 'A community for makers' },
  { name: 'Meet My Therapist', href: 'https://www.meetmytherapist.com', note: 'Finding the right fit' },
];
---

<Layout title="Jessica Loredo, Product Design Leader">
  <section class="intro">
    <div class="intro-main">
    <div class="intro-head" data-stage="1">
      <h1 class="intro-name">Jessica Loredo</h1>
      <p class="intro-role">
        I have 15 years in product design, a decade in EdTech, a
        background in both game design and counseling psychology. I build systems that put humans first. 
      </p>
    </div>

    <div class="intro-argument" data-stage="2">
      <p class="opening-question">
        What do digital product design and clinical counseling have in common?
      </p>
      <p>
        On the surface, very little. One industry focuses on shipping products to fill market gaps;
        the other supports people through complex human experiences.
      </p>
      <p>
        Look closer, though, and the boundary disappears. Across 15 years spanning design,
        educational applications, and mental health counseling, I've learned that these fields
        aren't separate lanes — they are different applications of the exact same foundation:
        empathy.
      </p>
      <details class="intro-more">
        <summary>
          <span class="more-open">Read more</span>
          <span class="more-close">Read less</span>
        </summary>
        <div class="intro-more-body">
          <p>
            Not too long ago the word "empathy" was everywhere in design spaces. I think many
            designers now tune out when hearing it, exactly because they remember a time when,
            despite their best efforts, empathy was difficult to quantify, measure, and convince an
            executive leadership team that it mattered.
          </p>
          <p>
            But empathy shouldn't be a soft skill taking a backseat to product strategy, or
            constrained to a persona the team looks at once and never again, nor is it just a
            buzzword in a therapeutic setting. It's the core construct we should build from when
            working with humans. When we start with understanding what someone needs, helping them
            achieve it becomes clearer.
          </p>
          <p>
            It isn't about handing anyone a shortcut; it's about providing the right conditions so
            they can get unstuck and move forward with their own goals, on their own terms.
          </p>
          <p>
            I love building tools that empower people just as much as I value being in a room to
            support someone one-on-one. Across my career, I've designed entire learning and creative
            platforms, self-exploration and career growth tools, experiences helping teenagers see
            who they can become, and accessible ways to match people with the right therapist.
          </p>
          <p>
            Across every project, I start with the exact same question: what is this person
            carrying, and how do I help them set it down so they can move forward more easily?
          </p>
          <p class="bridge">I start with empathy.</p>
        </div>
      </details>
    </div>

    <a href="#work" class="intro-cta" data-stage="4">See the work</a>
    </div>

    <div class="intro-side">
      <div class="intro-portrait" data-stage="1">
        <Image src={portrait} alt="Jessica Loredo" width={720} />
      </div>
      <div class="conclusion" data-stage="3">
        <p class="conclusion-line">
          Empathy isn't a soft skill. It's the construct I work from.
        </p>
      </div>
    </div>
  </section>

  <HowIWork />

  <section class="work-list" id="work" data-reveal>
    <div class="section-label">selected work</div>
    <div class="cases">
      {cases.map((c) => <CaseCard {...c} />)}
    </div>
  </section>

  <section class="building" data-reveal>
    <div class="section-label">also building</div>
    <p class="building-lede">
      Independent projects, designed and shipped end to end. Strategy is easier to claim than a
      thing people can open.
    </p>
    <ul class="build-list">
      {building.map(({ name, href, note }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            <span class="bl-name">{name}</span>
            <span class="bl-note">{note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Contact />
</Layout>

<style>
  /* ---- intro ---- */
  .intro {
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 48px 88px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 64px;
    align-items: start;
  }

  .intro-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    min-width: 0;
  }

  .intro-side {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .intro-portrait :global(img) {
    width: 95%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .intro-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .intro-name {
    font-family: var(--serif);
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .intro-role {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .intro-argument {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 62ch;
    padding-top: 8px;
    border-top: 0.5px solid var(--ink-faint);
  }

  .intro-argument p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--ink-soft);
    padding-top: 4px;
  }

  .intro-argument p.opening-question {
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 23px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--ink);
    text-wrap: balance;
    padding-top: 22px;
    margin-bottom: -8px;
  }

  .intro-more-body p.bridge {
    font-family: var(--serif);
    font-size: clamp(19px, 2.1vw, 23px);
    font-style: italic;
    line-height: 1.4;
    color: var(--ink);
    padding-top: 4px;
  }

  .intro-argument em {
    font-style: italic;
    color: var(--ink);
  }


  /* The claim also runs inline in the opening; here it works as the anchor
     under the portrait, so it's set apart rather than set enormous. */
  .conclusion {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 2px solid var(--teal);
    padding: 2px 0 2px 22px;
  }

  .conclusion-line {
    font-family: var(--serif);
    font-size: clamp(21px, 2.3vw, 29px);
    font-weight: 300;
    line-height: 1.28;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Disclosure keeps the landing short without hiding anything from a reader
     who has JS off: <details> works natively. */
  .intro-more {
    margin-top: 4px;
  }

  .intro-more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
    padding: 4px 0;
    width: fit-content;
  }

  .intro-more summary::-webkit-details-marker { display: none; }

  .intro-more summary::after {
    content: '';
    width: 22px;
    height: 0.5px;
    background: var(--teal);
    transition: width 0.25s ease;
  }

  .intro-more summary:hover::after { width: 34px; }
  .intro-more summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }

  .more-close { display: none; }
  .intro-more[open] .more-open { display: none; }
  .intro-more[open] .more-close { display: inline; }

  .intro-more-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 20px;
  }

  .intro-more-body p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .intro-cta {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-white);
    background: var(--ink);
    padding: 14px 28px;
    text-decoration: none;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .intro-cta:hover { background: var(--ink-soft); }
  .intro-cta:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

  /* ---- work ---- */
  .work-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 48px;
  }

  .cases {
    display: flex;
    flex-direction: column;
    border-bottom: 0.5px solid var(--ink-faint);
  }

  /* ---- building ---- */
  .building {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 48px;
  }

  .building-lede {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 54ch;
    margin-bottom: 32px;
  }

  .build-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--ink-faint);
    border: 0.5px solid var(--ink-faint);
  }

  .build-list a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 22px 20px;
    background: var(--warm-white);
    text-decoration: none;
    height: 100%;
    transition: background 0.2s;
  }

  .build-list a:hover { background: var(--cream); }
  .build-list a:focus-visible { outline: 2px solid var(--teal); outline-offset: -2px; }


  .bl-name {
    font-family: var(--serif);
    font-size: 18px;
    color: var(--ink);
  }

  .bl-note {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  /* ---- soft load + reveal ---- */
  [data-stage] {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  [data-stage='1'] { animation-delay: 0.05s; }
  [data-stage='2'] { animation-delay: 0.2s; }
  [data-stage='3'] { animation-delay: 0.45s; }
  [data-stage='4'] { animation-delay: 0.65s; }

  @keyframes rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Only hide reveal targets when JS is present to bring them back. Otherwise
     a failed script leaves the page blank below the intro. */
  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  :global(html.js) [data-reveal].shown {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-stage],
    :global(html.js) [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }

  /* Printing never scrolls, so nothing would ever reveal itself. */
  @media print {
    [data-stage],
    :global(html.js) [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .intro {
      padding: 116px 24px 72px;
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .intro-main { gap: 32px; order: 0; }
    .intro-side { display: contents; }
    .intro-portrait { order: -1; max-width: 200px; }
    .conclusion { order: 1; }
    .work-list, .building { padding: 56px 24px; }
  }
</style>

<script>
  const targets = document.querySelectorAll('[data-reveal]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('shown'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('shown');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
