---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CaseCard from '../components/CaseCard.astro';
import { cases } from '../data/cases.js';

import portrait from '../assets/img/selfie-creamcoat.jpeg';

const streams = [
  {
    name: 'Game design',
    body: 'SMU Guildhall. How motivation works mechanically: open loops, curiosity gaps, progression, the difficulty curve nobody has to explain.',
  },
  {
    name: 'Clinical training',
    body: 'MA in Counseling, in practicum now. How people actually change, and what psychological safety requires before they will.',
  },
  {
    name: 'Fifteen years shipping',
    body: 'K-12 platforms at scale. How any of it reaches a real teacher on a Tuesday morning in October.',
  },
];

const building = [
  { name: 'Start Your Future', href: 'https://startyourfuture.org', note: 'Career exploration for teens' },
  { name: 'Your Inner Constellation', href: 'https://www.your-inner-constellation.com', note: 'Traits made visible' },
  { name: 'Palette', href: 'https://palette.heartandhues.com', note: 'A community for makers' },
  { name: 'Meet My Therapist', href: 'https://www.meetmytherapist.com', note: 'Finding the right fit' },
];
---

<Layout title="Jessica Loredo, Product Design Leader">
  <section class="intro">
    <div class="intro-head" data-stage="1">
      <h1 class="intro-name">Jessica Loredo</h1>
      <p class="intro-role">
        Product Design Leader with 15+ years in EdTech, and a background in game design and
        psychology.
      </p>
    </div>

    <div class="intro-argument" data-stage="2">
      <p>
        After fifteen years building for teachers and students, I've watched <em>engagement</em> get
        thrown around like a magic bullet, as though naming it were the same as solving learning.
        Badges, avatars, mini games. They can absolutely hold a student's attention. But does
        holding attention guarantee learning? Does it make learning successful?
      </p>
      <p>
        You can build an interface that's beautiful, accessible, and genuinely engaging, and still
        have no idea whether the product works. The hard part was never the interface. It's
        cultivating engagement over time, and being able to measure it once you have.
      </p>
      <p>
        And underneath that sits the misconception I think most of edtech is built on. Engagement
        doesn't start at login. It doesn't even start when a student walks into the classroom. They
        arrive already carrying something: what happened at home that morning, whether they decided
        years ago that they're bad at math, whether this is a room where being wrong is survivable.
        A product meets a student somewhere in the middle of all that. Most are designed as though
        they meet them at zero.
      </p>
    </div>

    <div class="conclusion" data-stage="3">
      <span class="conclusion-label">Which is where I start</span>
      <p class="conclusion-line">
        Engagement is a psychological condition before it is a product feature.
      </p>
    </div>

    <a href="#work" class="intro-cta" data-stage="4">See the work</a>
  </section>

  <section class="streams" data-reveal>
    <div class="section-label">one claim, three kinds of evidence</div>
    <div class="stream-grid">
      {streams.map(({ name, body }) => (
        <div class="stream">
          <div class="stream-name">{name}</div>
          <p class="stream-body">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="work-list" id="work" data-reveal>
    <div class="section-label">selected work</div>
    <div class="cases">
      {cases.map((c) => <CaseCard {...c} />)}
    </div>
  </section>

  <section class="building" data-reveal>
    <div class="section-label">also building</div>
    <p class="building-lede">
      Independent products, designed and shipped end to end. Strategy is easier to claim than a
      thing people can open.
    </p>
    <ul class="build-list">
      {building.map(({ name, href, note }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            <span class="bl-name">{name}</span>
            <span class="bl-note">{note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-strip" id="about" data-reveal>
    <Image class="about-photo" src={portrait} alt="Jessica Loredo" width={760} />
    <div class="about-text">
      <p class="about-quote">"I am many things and I am also just, Jesi."</p>
      <p class="about-body">
        I'm a product design leader with fifteen years in K-12 edtech, and I'm most of the way
        through a master's in counseling. That second thing wasn't a career change. It was where the
        first one kept pointing.
      </p>
      <a class="about-more" href="/about">More about how I work</a>
    </div>
  </section>
</Layout>

<style>
  /* ---- intro ---- */
  .intro {
    max-width: 1200px;
    margin: 0 auto;
    padding: 150px 48px 88px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .intro-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .intro-name {
    font-family: var(--serif);
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .intro-role {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .intro-argument {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 62ch;
    padding-top: 8px;
    border-top: 0.5px solid var(--ink-faint);
  }

  .intro-argument p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--ink-soft);
    padding-top: 4px;
  }

  .intro-argument em {
    font-style: italic;
    color: var(--ink);
  }

  /* The claim reads as a conclusion the paragraphs above earn, so it's set
     apart rather than set enormous. */
  .conclusion {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 2px solid var(--teal);
    padding: 4px 0 4px 26px;
    max-width: 640px;
  }

  .conclusion-label {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .conclusion-line {
    font-family: var(--serif);
    font-size: clamp(25px, 3.4vw, 40px);
    font-weight: 300;
    line-height: 1.22;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: balance;
  }

  .intro-cta {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-white);
    background: var(--ink);
    padding: 14px 28px;
    text-decoration: none;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .intro-cta:hover { background: var(--ink-soft); }
  .intro-cta:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

  /* ---- streams ---- */
  .streams {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 48px;
  }

  .stream-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 40px;
  }

  .stream-name {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .stream-body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  /* ---- work ---- */
  .work-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 48px;
  }

  .cases {
    display: flex;
    flex-direction: column;
    border-bottom: 0.5px solid var(--ink-faint);
  }

  /* ---- building ---- */
  .building {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 48px;
  }

  .building-lede {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 54ch;
    margin-bottom: 32px;
  }

  .build-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--ink-faint);
    border: 0.5px solid var(--ink-faint);
  }

  .build-list a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 22px 20px;
    background: var(--warm-white);
    text-decoration: none;
    height: 100%;
    transition: background 0.2s;
  }

  .build-list a:hover { background: var(--cream); }
  .build-list a:focus-visible { outline: 2px solid var(--teal); outline-offset: -2px; }

  .about-more {
    display: inline-block;
    margin-top: 22px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 0.5px solid var(--ink-faint);
    padding-bottom: 4px;
    transition: border-color 0.2s;
  }

  .about-more:hover { border-color: var(--teal); }
  .about-more:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

  .bl-name {
    font-family: var(--serif);
    font-size: 18px;
    color: var(--ink);
  }

  .bl-note {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  /* ---- soft load + reveal ---- */
  [data-stage] {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.9s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  [data-stage='1'] { animation-delay: 0.05s; }
  [data-stage='2'] { animation-delay: 0.2s; }
  [data-stage='3'] { animation-delay: 0.45s; }
  [data-stage='4'] { animation-delay: 0.65s; }

  @keyframes rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Only hide reveal targets when JS is present to bring them back. Otherwise
     a failed script leaves the page blank below the intro. */
  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  :global(html.js) [data-reveal].shown {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-stage],
    :global(html.js) [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }

  /* Printing never scrolls, so nothing would ever reveal itself. */
  @media print {
    [data-stage],
    :global(html.js) [data-reveal] {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .intro { padding: 116px 24px 72px; gap: 32px; }
    .streams, .work-list, .building { padding: 56px 24px; }
    .conclusion { max-width: none; padding-left: 20px; }
  }
</style>

<script>
  const targets = document.querySelectorAll('[data-reveal]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('shown'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('shown');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
