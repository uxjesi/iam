---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout title="Not found · Jessica Loredo" description="That page doesn't exist.">
  <PageIntro
    eyebrow="404"
    title="No door here"
    lead="That page doesn't exist, or it hasn't been built yet."
  >
    Try the <a href="/">homepage</a>, or head straight to <a href="/work">the work</a>.
  </PageIntro>
</Layout>

<style>
  a {
    color: var(--teal);
    text-decoration: none;
    border-bottom: 0.5px solid var(--teal);
  }
</style>
